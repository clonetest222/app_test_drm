# ============================================================================
#  G4play Denuvo Manage — .env cua APP (duoc dong goi vao installer).
#
#  CHU Y: bat cu thu gi o day deu coi nhu CONG KHAI — app.asar giai nen bang
#  `npx asar extract` trong 30 giay.
#
#  TU BAN NAY: app doc THANG Supabase bang PUBLISHABLE key (giong g4_tool),
#  KHONG qua backend Deno nua (backend cu bi treo khi het quota -> 503).
#  Publishable key von duoc thiet ke cong khai; lop bao ve that la RLS ben
#  Supabase. Key duoi day da duoc XAO (moKhoa() trong main.js khoi phuc luc chay)
#  — chi de chong grep, khong phai bi mat that.
# ============================================================================

# Supabase (dung chung project voi g4_tool) — URL de thuong.
SUPABASE_URL=https://hghnapuiglfwomojhtbx.supabase.co

# PUBLISHABLE key DA XAO. Tao bang giau() trong main.js. Doi key -> xao lai roi thay.
SUPABASE_PUBLISHABLE_KEY_SCRAMBLED=LhWeulJbza8i_6ibbWdp6bplWo_r7crqL4AuCwRQqs_sEW

# Auto-update: repo GitHub chua Releases. Phat ban moi = tao Release tag cao hon,
# dinh kem file G4playDenuvoManage-Setup-x.y.z.exe. App tu phat hien va tai ve.
GH_RELEASE_REPO=clonetest222/app_test_drm

