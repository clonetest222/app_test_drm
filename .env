# ============================================================================
#  G4play Denuvo Manage — .env cua APP (duoc dong goi vao installer).
#
#  CHU Y: bat cu thu gi o day deu coi nhu CONG KHAI — app.asar giai nen bang
#  `npx asar extract` trong 30 giay. Vi vay o day KHONG con SUPABASE_URL /
#  SUPABASE_PUBLISHABLE_KEY nua: app khong duoc phep noi thang toi Supabase.
#
#  Bi mat that (service role key, khoa ma hoa, admin token) nam trong
#  backend/.env — CHI o server, khong bao gio di kem app.
# ============================================================================

# Backend Deno (Deno Deploy hoac VPS cua ban)
G4_API_BASE=https://g4play-denuvo.deno.dev

# Token dang ky thiet bi — phai TRUNG voi ENROLL_TOKEN trong backend/.env.
# Day khong phai bi mat that (ai cung rut duoc), chi la rao can toc do;
# bao ve that nam o rate limit + audit + khoa device ben backend.
G4_ENROLL_TOKEN=b60a0d18b819ddd4c849110bd029c830a3d4adbc94a43618
