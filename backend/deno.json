{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --watch main.ts",
    "start": "deno run --allow-net --allow-env main.ts",
    "keygen": "deno run scripts/keygen.ts",
    "migrate": "deno run --allow-net --allow-env scripts/migrate_encrypt.ts",
    "import": "deno run --allow-net --allow-env --allow-read scripts/import_accounts.ts",
    "check": "deno check main.ts scripts/*.ts",
    "test": "deno test src/",
    "interop": "deno run --allow-run --allow-write --allow-read --allow-env scripts/interop_check.ts",
    "deploy": "deployctl deploy --project=g4play-denuvo --entrypoint=main.ts --prod"
  },
  "fmt": {
    "lineWidth": 110,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  }
}
