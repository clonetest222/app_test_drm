# ============================================================================
#  backend/.env — CHI TON TAI TREN SERVER. Khong commit, khong dong goi vao app.
#  Sinh khoa: deno task keygen
# ============================================================================

# Supabase (Project Settings > API Keys)
# Giai doan 1: de trong SERVICE_ROLE va dien PUBLISHABLE_KEY -> backend chay duoc
#              nhung lo hong cu VAN CON (xem backend/README.md muc 7).
# Giai doan 2: dien SERVICE_ROLE (sb_secret_... hoac legacy service_role) roi chay
#              sql/02_khoa_anon.sql -> lo hong dong lai.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Khoa ma hoa mat khau + device secret (32 byte base64)
CRED_ENC_KEY=

# Token app gui khi dang ky thiet bi (cung gia tri voi G4_ENROLL_TOKEN trong .env cua app)
ENROLL_TOKEN=

# Token quan tri — chi dung tu may ban, KHONG nhung vao app
ADMIN_TOKEN=

# --- tuy chon ---
# false (mac dinh) = dung cot `password` plaintext y nhu truoc.
# true            = ma hoa mat khau tai DB. KHONG bat buoc: mat khau khong lo qua
#                   API o ca hai che do (RLS dong + phong bi ma hoa + rate limit).
ENCRYPT_AT_REST=false
PORT=8000
DENO_ENV=production
MAX_SKEW_MS=120000
LIMIT_DEVICE_HOUR=12
LIMIT_DEVICE_DAY=40
LIMIT_DEVICE_APPID_10M=4
ACCOUNT_COOLDOWN_SEC=90
ACCOUNT_FAIL_BLOCK=5
LIMIT_ENROLL_IP_HOUR=6
MIN_APP_VERSION=
