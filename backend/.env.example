# ============================================================================
#  backend/.env — CHI TON TAI TREN SERVER. Khong commit, khong dong goi vao app.
#
#  BAT BUOC dung 2 dong dau. Moi thu khac de trong cung chay: backend tu sinh
#  va luu trong Deno KV (admin token duoc in ra log lan chay dau).
# ============================================================================

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Giai doan 2 (va lo hong): dien secret key vao day roi chay sql/khoa_anon.sql.
# Doc ky thu tu trong backend/README.md muc 5 truoc khi chay SQL.
SUPABASE_SERVICE_ROLE_KEY=

# ---- deu TUY CHON ----
# CRED_ENC_KEY=      khoa AES base64 32 byte; khong dat -> tu sinh, giu trong KV
# ADMIN_TOKEN=       khong dat -> tu sinh, in ra log lan dau
# ENROLL_TOKEN=      khong dat -> bo qua kiem tra khi dang ky thiet bi
# ENCRYPT_AT_REST=false
# PORT=8000
# MAX_SKEW_MS=120000
# LIMIT_DEVICE_HOUR=12
# LIMIT_DEVICE_DAY=40
# LIMIT_DEVICE_APPID_10M=4
# ACCOUNT_COOLDOWN_SEC=90
# ACCOUNT_FAIL_BLOCK=5
# LIMIT_ENROLL_IP_HOUR=6
# MIN_APP_VERSION=
